{
  "name": "aleph-abis-migration",
  "version": "0.1.0",
  "private": true,
  "description": "Рабочее место оператора миграции АЛЕФ → АБИС Светоч",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/ssh.test.cjs",
    "format": "prettier --write src electron scripts tests index.html vite.config.ts tsconfig.json package.json docs README.md",
    "test:desktop": "npm run build && node --test tests/desktop.test.cjs",
    "postinstall": "node scripts/prepare-pty.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
